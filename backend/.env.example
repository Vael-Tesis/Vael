S3_BUCKET_NAME=vael-storage
SES_REGION=us-east-1

# Correos
EMAIL_FROM=noreply@vael.ai
EMAIL_FROM_NAME=VAEL

# SMTP local de desarrollo (no está en la sección 12 original; solo se usa si ENVIRONMENT != production).
# Defaults para un catcher local tipo Mailhog/aiosmtpd — no hacen falta credenciales reales.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Interno
INTERNAL_SERVICE_KEY=vael-internal-secret-2026

# Frontend
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
