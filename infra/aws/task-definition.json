{
  "family": "vael-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/vael-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/vael-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "vael-backend",
      "image": "PLACEHOLDER",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "ENVIRONMENT", "value": "production" },
        { "name": "DEBUG", "value": "false" },
        { "name": "ALGORITHM", "value": "HS256" },
        { "name": "ACCESS_TOKEN_EXPIRE_MINUTES", "value": "60" },
        { "name": "REFRESH_TOKEN_EXPIRE_DAYS", "value": "7" },
        { "name": "GEMINI_MODEL", "value": "gemini-3-flash" },
        { "name": "GEMINI_LIVE_MODEL", "value": "gemini-2.5-flash-native-audio-preview-12-2025" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "S3_BUCKET_NAME", "value": "vael-storage" },
        { "name": "SES_REGION", "value": "us-east-1" },
        { "name": "EMAIL_FROM", "value": "noreply@vael.ai" },
        { "name": "EMAIL_FROM_NAME", "value": "VAEL" },
        { "name": "FRONTEND_URL", "value": "https://app.vael.ai" },
        { "name": "ALLOWED_ORIGINS", "value": "https://app.vael.ai" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:vael/database-url" },
        { "name": "SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:vael/secret-key" },
        { "name": "INTERNAL_SERVICE_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:vael/internal-service-key" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vael-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
