# Datos simulados de desarrollo (DEC-008). Desactivados por defecto: solo "true" los activa.
VITE_MOCKS=false

# Destino del proxy /api del servidor de desarrollo de Vite.
# Local: http://localhost:8000 (por defecto). En docker-compose se fija a http://backend:8000.
API_PROXY_TARGET=http://localhost:8000
